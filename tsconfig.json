    "outDir": "dist",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "jsx": "react-native",
    "allowJs": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
